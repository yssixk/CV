# Copy to .env (gitignored) and fill in. NEVER commit .env.

# --- LLM feedback layer (optional; OFF by default) ---
USE_LLM_FEEDBACK=false

# Provider: "openai" = any OpenAI-compatible endpoint (router, proxy, gateway);
# "gemini" = Google AI Studio directly.
LLM_PROVIDER=openai
# For LLM_PROVIDER=openai: the base URL of the compatible endpoint (with /v1).
LLM_BASE_URL=
# For LLM_PROVIDER=gemini: a Google AI Studio key. For openai: the router's API key.
GEMINI_API_KEY=
# Model id as exposed by the provider (router models are prefixed, e.g. ag/...).
GEMINI_MODEL=gemini-2.0-flash

LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=20

# --- Upload safety ---
MAX_UPLOAD_MB=5.0
PARSE_TIMEOUT_SECONDS=15

# --- Rate limiting (per session, per minute) ---
RATE_LIMIT_PER_MINUTE=5

# --- Models / thresholds ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
REDUNDANCY_THRESHOLD=0.85
RELEVANCE_MATCH_THRESHOLD=0.50
NLP_EXTRACTOR_ENABLED=true
NER_MODEL=Davlan/xlm-roberta-base-ner-hrl
VERIFIER_MODE=keyword
